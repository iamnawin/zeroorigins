{
  "name": "ZeroOrigins — Lead Capture",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-capture",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "zeroorigins-lead-capture"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "field-name",
              "name": "name",
              "value": "={{ $json.body.name || $json.body.full_name || $json.body.Name || '' }}",
              "type": "string"
            },
            {
              "id": "field-email",
              "name": "email",
              "value": "={{ $json.body.email || $json.body.Email || '' }}",
              "type": "string"
            },
            {
              "id": "field-business",
              "name": "business",
              "value": "={{ $json.body.business || $json.body.company || $json.body.Business || '' }}",
              "type": "string"
            },
            {
              "id": "field-message",
              "name": "message",
              "value": "={{ $json.body.message || $json.body.Message || '' }}",
              "type": "string"
            },
            {
              "id": "field-source",
              "name": "source",
              "value": "={{ $json.body.source || $json.body.utm_source || 'Website' }}",
              "type": "string"
            },
            {
              "id": "field-timestamp",
              "name": "timestamp",
              "value": "={{ new Date().toISOString() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Normalize Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [420, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp": "={{ $json.timestamp }}",
            "Name": "={{ $json.name }}",
            "Email": "={{ $json.email }}",
            "Business": "={{ $json.business }}",
            "Message": "={{ $json.message }}",
            "Source": "={{ $json.source }}",
            "Status": "New",
            "Followup Sent": "FALSE",
            "Followup Date": ""
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Log Lead to Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [640, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "YOUR_EMAIL@gmail.com",
        "subject": "New Lead: {{ $('Normalize Fields').item.json.name }} — {{ $('Normalize Fields').item.json.business }}",
        "message": "=<p>You have a new lead from your website.</p>\n<table style=\"font-family:sans-serif;font-size:14px;border-collapse:collapse\">\n  <tr><td style=\"padding:6px 12px;font-weight:bold\">Name</td><td style=\"padding:6px 12px\">{{ $('Normalize Fields').item.json.name }}</td></tr>\n  <tr><td style=\"padding:6px 12px;font-weight:bold\">Email</td><td style=\"padding:6px 12px\">{{ $('Normalize Fields').item.json.email }}</td></tr>\n  <tr><td style=\"padding:6px 12px;font-weight:bold\">Business</td><td style=\"padding:6px 12px\">{{ $('Normalize Fields').item.json.business }}</td></tr>\n  <tr><td style=\"padding:6px 12px;font-weight:bold\">Message</td><td style=\"padding:6px 12px\">{{ $('Normalize Fields').item.json.message }}</td></tr>\n  <tr><td style=\"padding:6px 12px;font-weight:bold\">Source</td><td style=\"padding:6px 12px\">{{ $('Normalize Fields').item.json.source }}</td></tr>\n  <tr><td style=\"padding:6px 12px;font-weight:bold\">Time</td><td style=\"padding:6px 12px\">{{ $('Normalize Fields').item.json.timestamp }}</td></tr>\n</table>\n<p><a href=\"https://calendly.com/zeroorigins\">Book a follow-up call</a></p>",
        "options": {
          "appendAttribution": false,
          "senderName": "ZeroOrigins"
        }
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Notify Owner",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [860, 200],
      "credentials": {
        "gmailOAuth2": {
          "id": "YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "={{ $('Normalize Fields').item.json.email }}",
        "subject": "Got it — here's what happens next",
        "message": "=<p>Hi {{ $('Normalize Fields').item.json.name }},</p>\n\n<p>Thanks for reaching out. I've received your message and will get back to you within 24 hours.</p>\n\n<p>In the meantime, if you'd like to skip the back-and-forth and book a call directly, you can do that here:</p>\n\n<p><a href=\"https://calendly.com/zeroorigins\" style=\"background:#000;color:#fff;padding:10px 20px;border-radius:6px;text-decoration:none;display:inline-block\">Book a 30-minute call</a></p>\n\n<p>On the call we'll talk through your goals, what you're currently working with, and the fastest path to get you a working system.</p>\n\n<p>Talk soon,<br>Naveen<br>ZeroOrigins AI<br>hello@zeroorigins.in</p>",
        "options": {
          "appendAttribution": false,
          "senderName": "Naveen at ZeroOrigins"
        }
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Send Confirmation to Lead",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [860, 400],
      "credentials": {
        "gmailOAuth2": {
          "id": "YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"success\", \"message\": \"Thanks! We'll be in touch within 24 hours.\" }",
        "options": {}
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1080, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Normalize Fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Fields": {
      "main": [
        [
          {
            "node": "Log Lead to Sheet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Lead to Sheet": {
      "main": [
        [
          {
            "node": "Notify Owner",
            "type": "main",
            "index": 0
          },
          {
            "node": "Send Confirmation to Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify Owner": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Confirmation to Lead": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "versionId": "a1b2c3d4-ffff-4000-8000-zeroorigins01",
  "meta": {
    "templateCredsSetupCompleted": false,
    "instanceId": "zeroorigins-workflow-starter-kit"
  },
  "id": "zeroorigins-lead-capture-v1",
  "tags": [
    { "name": "ZeroOrigins" },
    { "name": "Lead Capture" }
  ]
}
