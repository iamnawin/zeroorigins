    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "Quick question about your automation setup",
        "message": "=<p>Hi {{ $json.name }},</p>\n\n<p>Thanks for reaching out.</p>\n\n<p>We build AI automation systems for {{ $json.industry || 'businesses' }} — the kind that run lead capture, qualification, and follow-up without anyone manually touching a thing.</p>\n\n<p>From your message it sounds like there might be a fit. The fastest way to find out is a 30-minute call — no prep needed from your side.</p>\n\n<p><a href=\"https://calendly.com/zerooriginsai/30min\" style=\"background:#111;color:#fff;padding:10px 24px;border-radius:6px;text-decoration:none;display:inline-block;font-family:sans-serif\">Book a 30-minute call</a></p>\n\n<p>Talk soon,<br>Naveen<br>ZeroOrigins AI<br>hello@zeroorigins.in</p>",
        "options": { "appendAttribution": false, "senderName": "Naveen at ZeroOrigins" }
      },
