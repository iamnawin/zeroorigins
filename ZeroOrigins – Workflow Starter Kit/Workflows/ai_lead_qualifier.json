    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "f1", "name": "name",      "value": "={{ $json.body.name || $json.body.full_name || '' }}", "type": "string" },
            { "id": "f2", "name": "email",     "value": "={{ $json.body.email || '' }}", "type": "string" },
            { "id": "f3", "name": "business",  "value": "={{ $json.body.business || $json.body.company || '' }}", "type": "string" },
            { "id": "f4", "name": "message",   "value": "={{ $json.body.message || '' }}", "type": "string" },
            { "id": "f5", "name": "source",    "value": "={{ $json.body.source || $json.body.utm_source || 'Website' }}", "type": "string" },
            { "id": "f6", "name": "domain",    "value": "={{ $json.body.email ? $json.body.email.split('@')[1] : '' }}", "type": "string" },
            { "id": "f7", "name": "timestamp", "value": "={{ new Date().toISOString() }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "alf-002",
      "name": "Normalize Lead Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [420, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"received\", \"message\": \"Your submission is being processed.\" }",
        "options": {}
      },
      "id": "alf-003",
      "name": "Ack Immediately",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [640, 140]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://person.clearbit.com/v2/combined/find?email={{ encodeURIComponent($json.email) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": { "response": { "neverError": true } }
        }
      },
      "id": "alf-004",
      "name": "Clearbit Enrich Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, 340],
      "credentials": {
        "httpHeaderAuth": {
          "id": "YOUR_CLEARBIT_CREDENTIAL_ID",
          "name": "Clearbit API"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "m1",  "name": "name",           "value": "={{ $json.person?.name?.fullName || $('Normalize Lead Fields').item.json.name }}", "type": "string" },
            { "id": "m2",  "name": "email",          "value": "={{ $('Normalize Lead Fields').item.json.email }}", "type": "string" },
            { "id": "m3",  "name": "business",       "value": "={{ $json.company?.name || $('Normalize Lead Fields').item.json.business }}", "type": "string" },
            { "id": "m4",  "name": "message",        "value": "={{ $('Normalize Lead Fields').item.json.message }}", "type": "string" },
            { "id": "m5",  "name": "source",         "value": "={{ $('Normalize Lead Fields').item.json.source }}", "type": "string" },
            { "id": "m6",  "name": "jobTitle",       "value": "={{ $json.person?.employment?.title || '' }}", "type": "string" },
            { "id": "m7",  "name": "companySize",    "value": "={{ $json.company?.metrics?.employees || 0 }}", "type": "number" },
            { "id": "m8",  "name": "industry",       "value": "={{ $json.company?.category?.industry || '' }}", "type": "string" },
            { "id": "m9",  "name": "companyRevenue", "value": "={{ $json.company?.metrics?.estimatedAnnualRevenue || '' }}", "type": "string" },
            { "id": "m10", "name": "linkedinUrl",    "value": "={{ $json.person?.linkedin?.handle ? 'https://linkedin.com/in/' + $json.person.linkedin.handle : '' }}", "type": "string" },
            { "id": "m11", "name": "timestamp",      "value": "={{ $('Normalize Lead Fields').item.json.timestamp }}", "type": "string" },
            { "id": "m12", "name": "domain",         "value": "={{ $('Normalize Lead Fields').item.json.domain }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "alf-005",
      "name": "Merge Enrichment Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [860, 340]
    },
    {
      "parameters": {
        "resource": "chat",
        "operation": "complete",
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a B2B lead qualification expert for ZeroOrigins AI, an AI systems and automation agency. Analyze the lead and respond ONLY with valid JSON in exactly this format:\n{\n  \"score\": <integer 1-10>,\n  \"intent\": \"<buy_now|explore|research|unclear>\",\n  \"urgency\": \"<high|medium|low>\",\n  \"budget_signal\": \"<high|medium|low|unknown>\",\n  \"ideal_customer\": <true|false>,\n  \"reasoning\": \"<2-3 sentence summary>\",\n  \"recommended_action\": \"<specific first-response suggestion>\"\n}\n\nScoring guide:\n10 = Decision-maker, specific problem, clear budget and urgency\n7-9 = Clear need, relevant business, engaged message\n4-6 = Vague interest, could qualify with follow-up\n1-3 = Student/researcher/competitor, no buying signals"
            },
            {
              "role": "user",
              "content": "=Qualify this inbound lead:\n\nName: {{ $json.name }}\nEmail: {{ $json.email }}\nJob Title: {{ $json.jobTitle }}\nBusiness: {{ $json.business }}\nIndustry: {{ $json.industry }}\nCompany size: {{ $json.companySize }} employees\nEst. revenue: {{ $json.companyRevenue }}\nMessage: {{ $json.message }}\nSource: {{ $json.source }}"
            }
          ]
        },
        "simplifyOutput": true,
        "options": {
          "temperature": 0.2,
          "maxTokens": 400
        }
      },
      "id": "alf-006",
      "name": "AI Lead Qualification",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.7,
      "position": [1080, 340],
      "credentials": {
        "openAiApi": {
          "id": "YOUR_OPENAI_CREDENTIAL_ID",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Merge Enrichment Data').item.json;\nlet ai;\ntry {\n  const raw = $input.item.json.content || $input.item.json.message?.content || '{}';\n  ai = JSON.parse(raw);\n} catch (e) {\n  ai = { score: 5, intent: 'unclear', urgency: 'medium', budget_signal: 'unknown', ideal_customer: false, reasoning: 'AI parse error — manual review needed', recommended_action: 'Reply with discovery questions' };\n}\n\nconst tier = ai.score >= 8 ? 'HOT' : ai.score >= 5 ? 'WARM' : 'COLD';\n\nreturn [{\n  json: {\n    ...lead,\n    score: ai.score || 5,\n    intent: ai.intent || 'unclear',\n    urgency: ai.urgency || 'medium',\n    budgetSignal: ai.budget_signal || 'unknown',\n    isIdealCustomer: ai.ideal_customer || false,\n    aiReasoning: ai.reasoning || '',\n    recommendedAction: ai.recommended_action || '',\n    leadTier: tier\n  }\n}];"
      },
      "id": "alf-007",
      "name": "Parse AI Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1300, 340]
    },
    {
      "parameters": {
        "rules": {
          "rules": [
            {
              "conditions": {
                "conditions": [{ "leftValue": "={{ $json.score }}", "rightValue": 8, "operator": { "type": "number", "operation": "gte" } }],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Hot"
            },
            {
              "conditions": {
                "conditions": [{ "leftValue": "={{ $json.score }}", "rightValue": 5, "operator": { "type": "number", "operation": "gte" } }],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Warm"
            }
          ]
        },
        "options": { "fallbackOutput": "extra" }
      },
      "id": "alf-008",
      "name": "Route by Lead Score",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [1520, 340]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": { "__rl": true, "value": "YOUR_SLACK_CHANNEL_ID", "mode": "id" },
        "text": "=:fire: *HOT LEAD — Score {{ $json.score }}/10*\n\n*Name:* {{ $json.name }}\n*Business:* {{ $json.business }}\n*Title:* {{ $json.jobTitle || 'Unknown' }}\n*Industry:* {{ $json.industry || 'Unknown' }}\n*Company size:* {{ $json.companySize || '?' }} employees | Rev: {{ $json.companyRevenue || 'Unknown' }}\n*Source:* {{ $json.source }}\n\n*Message:*\n> {{ $json.message }}\n\n*AI Analysis:* {{ $json.aiReasoning }}\n*Intent:* {{ $json.intent }} | *Urgency:* {{ $json.urgency }} | *Budget Signal:* {{ $json.budgetSignal }}\n\n:dart: *Recommended:* {{ $json.recommendedAction }}\n\n:email: {{ $json.email }}{{ $json.linkedinUrl ? '\n:linkedin: ' + $json.linkedinUrl : '' }}",
        "otherOptions": { "mrkdwn": true }
      },
      "id": "alf-009",
      "name": "Slack HOT Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [1740, 120],
      "credentials": {
        "slackApi": {
          "id": "YOUR_SLACK_CREDENTIAL_ID",
          "name": "Slack account"
        }
      }
    },
    {
      "parameters": {
        "resource": "chat",
        "operation": "complete",
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are Naveen from ZeroOrigins AI, an AI systems and automation agency. Write a short, sharp, personalized reply to a high-value inbound lead. Rules: warm but direct, reference their specific message, no generic openers like 'Great to hear from you', no fluff. Maximum 100 words. Sign off: Naveen. Output ONLY the email body — no subject line, no extra commentary."
            },
            {
              "role": "user",
              "content": "=Write a personalized reply to this lead:\n\nName: {{ $json.name }}\nBusiness: {{ $json.business }}\nTitle: {{ $json.jobTitle }}\nIndustry: {{ $json.industry }}\nMessage they sent: {{ $json.message }}\nAI recommended action: {{ $json.recommendedAction }}\n\nInclude this Calendly link naturally: https://calendly.com/zerooriginsai/30min"
            }
          ]
        },
        "simplifyOutput": true,
        "options": { "temperature": 0.7, "maxTokens": 250 }
      },
      "id": "alf-010",
      "name": "Write Personalized Email",
