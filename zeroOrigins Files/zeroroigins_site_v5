<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ZeroOrigins — AI Systems & Automation Lab</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://zeroorigins.in" crossorigin>
  <link rel="dns-prefetch" href="//zeroorigins.in">
  <link rel="preload" as="image" href="https://zeroorigins.in/wp-content/uploads/2026/05/ZerorOrigins-loho-1.png" fetchpriority="high">
  <link rel="preload" as="video" href="https://zeroorigins.in/wp-content/uploads/2026/05/infinity-loop3.mp4" type="video/mp4" crossorigin>
  
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --bg: #030408;
      --bg-elevated: #0a0c12;
      --surface: #0f1218;
      --border: rgba(255, 255, 255, 0.06);
      --border-strong: rgba(255, 255, 255, 0.12);
      --text: #f4f4f5;
      --text-muted: rgba(244, 244, 245, 0.6);
      --text-subtle: rgba(244, 244, 245, 0.4);
      --accent: #22d3ee;
      --accent-glow: rgba(34, 211, 238, 0.3);
      --gold: #fbbf24;
      --gold-glow: rgba(251, 191, 36, 0.25);
      --purple: #a78bfa;
      --purple-glow: rgba(167, 139, 250, 0.25);
      --rose: #fb7185;
      --rose-glow: rgba(251, 113, 133, 0.25);
      --radius: 16px;
      --radius-lg: 24px;
      --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
      --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      font-size: 16px;
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    ::selection {
      background: var(--accent);
      color: var(--bg);
    }

    ::-webkit-scrollbar {
      width: 6px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: var(--border-strong);
      border-radius: 3px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(255, 255, 255, 0.2);
    }

    .display-xl {
      font-family: 'Space Grotesk', sans-serif;
      font-size: clamp(2.5rem, 6vw, 4.5rem);
      font-weight: 700;
      line-height: 1.05;
      letter-spacing: -0.03em;
    }

    .display-lg {
      font-family: 'Space Grotesk', sans-serif;
      font-size: clamp(1.75rem, 4vw, 3rem);
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: -0.02em;
    }

    .text-lg {
      font-size: 1.125rem;
      line-height: 1.7;
    }

    .text-base {
      font-size: 1rem;
      line-height: 1.65;
    }

    .container {
      width: 100%;
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 clamp(1.5rem, 5vw, 4rem);
    }

    .section {
      padding: clamp(5rem, 12vh, 8rem) 0;
      position: relative;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.875rem 1.75rem;
      font-size: 0.9375rem;
      font-weight: 600;
      font-family: 'Space Grotesk', sans-serif;
      border-radius: 999px;
      text-decoration: none;
      cursor: pointer;
      border: none;
      transition: all 0.4s var(--ease-out);
      position: relative;
      overflow: hidden;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--gold), #f59e0b);
      color: var(--bg);
      box-shadow: 0 0 40px var(--gold-glow), 0 4px 16px rgba(0, 0, 0, 0.3);
    }

    .btn-primary::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, #fcd34d, var(--gold));
      opacity: 0;
      transition: opacity 0.3s;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 0 60px var(--gold-glow), 0 8px 24px rgba(0, 0, 0, 0.4);
    }

    .btn-primary:hover::before {
      opacity: 1;
    }

    .btn-primary span {
      position: relative;
      z-index: 1;
    }

    .btn-secondary {
      background: rgba(255, 255, 255, 0.03);
      color: var(--text);
      border: 1px solid var(--border-strong);
      backdrop-filter: blur(12px);
    }

    .btn-secondary:hover {
      background: rgba(255, 255, 255, 0.06);
      border-color: var(--accent);
      color: var(--accent);
      transform: translateY(-2px);
    }

    /* Navigation */
    nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 1000;
      padding: 1rem 0;
      background: rgba(3, 4, 8, 0.8);
      backdrop-filter: blur(24px) saturate(180%);
      border-bottom: 1px solid var(--border);
    }

    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
      color: var(--text);
    }

    .logo img {
      height: 36px;
      width: auto;
    }

    .logo-text {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: 1.125rem;
      letter-spacing: -0.02em;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 2rem;
      list-style: none;
    }

    .nav-links a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.875rem;
      font-weight: 500;
      transition: color 0.2s;
      position: relative;
    }

    .nav-links a::after {
      content: '';
      position: absolute;
      bottom: -4px;
      left: 0;
      width: 0;
      height: 1px;
      background: var(--accent);
      transition: width 0.3s var(--ease-out);
    }

    .nav-links a:hover {
      color: var(--text);
    }

    .nav-links a:hover::after {
      width: 100%;
    }

    .nav-cta {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .nav-cta .btn {
      padding: 0.625rem 1.25rem;
      font-size: 0.8125rem;
    }

    .menu-toggle {
      display: none;
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border);
      color: var(--text);
      cursor: pointer;
      transition: all 0.2s;
    }

    .menu-toggle:hover {
      background: rgba(255, 255, 255, 0.06);
    }

    .mobile-nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: var(--bg);
      z-index: 999;
      display: flex;
      flex-direction: column;
      padding: 6rem 2rem 2rem;
      transform: translateY(-100%);
      opacity: 0;
      transition: all 0.4s var(--ease-out);
      pointer-events: none;
    }

    .mobile-nav.active {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }

    .mobile-nav-links {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      list-style: none;
    }

    .mobile-nav-links a {
      display: block;
      padding: 1rem;
      color: var(--text);
      text-decoration: none;
      font-size: 1.25rem;
      font-weight: 600;
      font-family: 'Space Grotesk', sans-serif;
      border-radius: 12px;
      transition: all 0.2s;
    }

    .mobile-nav-links a:hover {
      background: rgba(255, 255, 255, 0.03);
      padding-left: 1.5rem;
    }

    /* Hero Section */
    .hero {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      position: relative;
      overflow: hidden;
      padding-top: 5rem;
    }

    .hero-video-container {
      position: absolute;
      inset: 0;
      z-index: 0;
    }

    .hero-video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0.6;
      filter: saturate(1.2) contrast(1.1);
    }

    .hero-video-overlay {
      position: absolute;
      inset: 0;
      background: 
        radial-gradient(ellipse 80% 60% at 20% 50%, rgba(3, 4, 8, 0.9) 0%, transparent 70%),
        radial-gradient(ellipse 60% 50% at 80% 30%, rgba(251, 191, 36, 0.08) 0%, transparent 50%),
        radial-gradient(ellipse 50% 40% at 70% 70%, rgba(34, 211, 238, 0.06) 0%, transparent 50%),
        linear-gradient(180deg, rgba(3, 4, 8, 0.4) 0%, transparent 30%, transparent 70%, rgba(3, 4, 8, 0.8) 100%);
      pointer-events: none;
    }

    .hero-content {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: 1fr;
      gap: 3rem;
      align-items: center;
    }

    .hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      background: rgba(34, 211, 238, 0.08);
      border: 1px solid rgba(34, 211, 238, 0.2);
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 1.5rem;
      animation: fadeInUp 0.8s var(--ease-out) 0.2s both;
    }

    .pulse-dot {
      width: 6px;
      height: 6px;
      background: var(--accent);
      border-radius: 50%;
      animation: pulse 2s ease-in-out infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(1.2); }
    }

    .hero-title {
      margin-bottom: 1.5rem;
      animation: fadeInUp 0.8s var(--ease-out) 0.3s both;
    }

    .hero-title .line {
      display: block;
    }

    .hero-title .accent {
      background: linear-gradient(135deg, var(--gold), var(--accent));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-description {
      max-width: 540px;
      color: var(--text-muted);
      margin-bottom: 2.5rem;
      animation: fadeInUp 0.8s var(--ease-out) 0.4s both;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      margin-bottom: 4rem;
      animation: fadeInUp 0.8s var(--ease-out) 0.5s both;
    }

    .hero-stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      animation: fadeInUp 0.8s var(--ease-out) 0.6s both;
    }

    .stat-card {
      padding: 1.25rem;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      backdrop-filter: blur(12px);
      transition: all 0.3s var(--ease-out);
    }

    .stat-card:hover {
      background: rgba(255, 255, 255, 0.04);
      border-color: var(--border-strong);
      transform: translateY(-4px);
    }

    .stat-icon {
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, 0.03);
      border-radius: 10px;
      margin-bottom: 0.75rem;
      color: var(--accent);
    }

    .stat-icon svg {
      width: 18px;
      height: 18px;
    }

    .stat-label {
      font-size: 0.6875rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text);
      margin-bottom: 0.25rem;
    }

    .stat-desc {
      font-size: 0.8125rem;
      color: var(--text-subtle);
      line-height: 1.4;
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Section Headers */
    .section-header {
      margin-bottom: 3rem;
    }

    .section-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 1rem;
    }

    .section-eyebrow::before {
      content: '';
      width: 8px;
      height: 8px;
      background: var(--gold);
      border-radius: 2px;
    }

    .section-title {
      margin-bottom: 0.75rem;
    }

    .section-subtitle {
      color: var(--text-muted);
      max-width: 600px;
    }

    /* ========================================
       UNIVERSAL POKEMON CARD STYLES
       ======================================== */
    
    /* Card perspective container */
    .card-perspective {
      perspective: 2000px;
    }

    /* Base reactive card */
    .reactive-card {
      position: relative;
      transform-style: preserve-3d;
      transition: transform 0.15s ease-out, box-shadow 0.3s ease;
      will-change: transform;
      cursor: default;
    }

    /* Holographic shine layer */
    .card-holo {
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: linear-gradient(
        125deg,
        transparent 0%,
        rgba(255, 255, 255, 0) 40%,
        rgba(255, 255, 255, 0.12) 45%,
        rgba(34, 211, 238, 0.2) 50%,
        rgba(167, 139, 250, 0.2) 55%,
        rgba(251, 191, 36, 0.15) 60%,
        transparent 100%
      );
      background-size: 200% 200%;
      background-position: 100% 100%;
      opacity: 0;
      mix-blend-mode: overlay;
      pointer-events: none;
      transition: opacity 0.3s ease;
      z-index: 5;
    }

    /* Rainbow glint overlay */
    .card-glint {
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: linear-gradient(
        calc(var(--glint-angle, 135deg)),
        transparent 0%,
        transparent 30%,
        rgba(34, 211, 238, 0.06) 35%,
        rgba(167, 139, 250, 0.06) 40%,
        rgba(251, 113, 133, 0.06) 45%,
        rgba(251, 191, 36, 0.06) 50%,
        rgba(34, 211, 238, 0.06) 55%,
        transparent 60%,
        transparent 100%
      );
      background-size: 300% 300%;
      background-position: var(--glint-x, 0%) var(--glint-y, 0%);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
      z-index: 6;
    }

    /* Spotlight effect */
    .card-spotlight {
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: radial-gradient(
        500px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
        rgba(255, 255, 255, 0.05),
        transparent 40%
      );
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
      z-index: 7;
    }

    /* Border glow effect */
    .card-border-glow {
      position: absolute;
      inset: -1px;
      border-radius: inherit;
      padding: 1px;
      background: linear-gradient(135deg, 
        rgba(255, 255, 255, 0.08) 0%, 
        rgba(255, 255, 255, 0.02) 50%,
        var(--card-accent, rgba(34, 211, 238, 0.1)) 100%);
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      opacity: 0;
      transition: opacity 0.4s ease;
      pointer-events: none;
      z-index: 8;
    }

    /* Floating particles */
    .card-particles {
      position: absolute;
      inset: 0;
      border-radius: inherit;
      overflow: hidden;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.3s ease;
      z-index: 4;
    }

    .particle {
      position: absolute;
      width: 3px;
      height: 3px;
      background: var(--card-accent, var(--accent));
      border-radius: 50%;
      opacity: 0;
      animation: particleFloat 2.5s ease-in-out infinite;
    }

    @keyframes particleFloat {
      0%, 100% {
        opacity: 0;
        transform: translateY(0) scale(0);
      }
      50% {
        opacity: 0.7;
        transform: translateY(-25px) scale(1);
      }
    }

    /* Card content wrapper */
    .card-content {
      position: relative;
      z-index: 10;
    }

    /* Hover states for reactive cards */
    .reactive-card:hover {
      transform: perspective(1000px) rotateX(var(--rotateX, 0deg)) rotateY(var(--rotateY, 0deg)) scale(1.02) translateZ(8px);
    }

    .reactive-card:hover .card-holo {
      opacity: 0.8;
      animation: holoShift 3s linear infinite;
    }

    .reactive-card:hover .card-glint {
      opacity: 1;
    }

    .reactive-card:hover .card-spotlight {
      opacity: 1;
    }

    .reactive-card:hover .card-border-glow {
      opacity: 1;
    }

    .reactive-card:hover .card-particles {
      opacity: 1;
    }

    @keyframes holoShift {
      0% { background-position: 0% 0%; }
      50% { background-position: 100% 100%; }
      100% { background-position: 0% 0%; }
    }

    /* Card color variants */
    .card-cyan {
      --card-accent: var(--accent);
      --card-accent-glow: var(--accent-glow);
    }

    .card-cyan:hover {
      box-shadow: 
        0 25px 50px -12px rgba(0, 0, 0, 0.5),
        0 0 40px rgba(34, 211, 238, 0.12),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }

    .card-purple {
      --card-accent: var(--purple);
      --card-accent-glow: var(--purple-glow);
    }

    .card-purple:hover {
      box-shadow: 
        0 25px 50px -12px rgba(0, 0, 0, 0.5),
        0 0 40px rgba(167, 139, 250, 0.12),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }

    .card-gold {
      --card-accent: var(--gold);
      --card-accent-glow: var(--gold-glow);
    }

    .card-gold:hover {
      box-shadow: 
        0 25px 50px -12px rgba(0, 0, 0, 0.5),
        0 0 40px rgba(251, 191, 36, 0.12),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }

    .card-rose {
      --card-accent: var(--rose);
      --card-accent-glow: var(--rose-glow);
    }

    .card-rose:hover {
      box-shadow: 
        0 25px 50px -12px rgba(0, 0, 0, 0.5),
        0 0 40px rgba(251, 113, 133, 0.12),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }

    /* ========================================
       BUILD SECTION - REACTIVE CARDS
       ======================================== */
    .build-section {
      background: linear-gradient(180deg, var(--bg) 0%, var(--bg-elevated) 100%);
    }

    .build-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }

    .build-card {
      padding: 2rem;
      background: linear-gradient(165deg, 
        rgba(15, 18, 25, 0.9) 0%, 
        rgba(10, 12, 18, 0.95) 50%,
        rgba(8, 10, 15, 0.9) 100%);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: var(--radius-lg);
      overflow: hidden;
    }

    .build-icon {
      width: 48px;
      height: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      background: rgba(255, 255, 255, 0.03);
      border-radius: 12px;
      margin-bottom: 1.25rem;
      transition: transform 0.3s var(--ease-out);
    }

    .build-card:hover .build-icon {
      transform: translateZ(15px) scale(1.05);
    }

    .build-card h3 {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.125rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
      transition: transform 0.3s var(--ease-out);
    }

    .build-card:hover h3 {
      transform: translateZ(10px);
    }

    .build-card p {
      font-size: 0.875rem;
      color: var(--text-subtle);
      line-height: 1.6;
    }

    /* ========================================
       PRODUCTS SECTION - REACTIVE CARDS
       ======================================== */
    .products-section {
      background: var(--bg);
      position: relative;
      overflow: hidden;
    }

    .products-section::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 600px;
      background: radial-gradient(ellipse 80% 50% at 50% 0%, rgba(34, 211, 238, 0.03) 0%, transparent 60%);
      pointer-events: none;
    }

    .products-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 2rem;
      margin-bottom: 3rem;
      flex-wrap: wrap;
      position: relative;
      z-index: 1;
    }

    .products-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
      perspective: 2000px;
      position: relative;
      z-index: 1;
    }

    .product-card {
      padding: 1.75rem;
      background: linear-gradient(165deg, 
        rgba(15, 18, 25, 0.95) 0%, 
        rgba(10, 12, 18, 0.98) 50%,
        rgba(8, 10, 15, 0.95) 100%);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: var(--radius-lg);
      overflow: hidden;
    }

    .product-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1rem;
    }

    .product-category {
      font-size: 0.6875rem;
