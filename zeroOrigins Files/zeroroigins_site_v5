  <script>
    // Mobile Navigation Toggle
    (function() {
      var toggle = document.querySelector('.menu-toggle');
      var mobileNav = document.querySelector('.mobile-nav');
      var mobileLinks = document.querySelectorAll('.mobile-nav a');
      
      if (!toggle || !mobileNav) return;

      function toggleMenu(open) {
        mobileNav.classList.toggle('active', open);
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        document.body.style.overflow = open ? 'hidden' : '';
      }

      toggle.addEventListener('click', function() {
        var isOpen = mobileNav.classList.contains('active');
        toggleMenu(!isOpen);
      });

      mobileLinks.forEach(function(link) {
        link.addEventListener('click', function() {
          toggleMenu(false);
        });
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') toggleMenu(false);
      });
    })();

    // Scroll Reveal Animation
    (function() {
      var reveals = document.querySelectorAll('.reveal');
      
      if (!reveals.length) return;

      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      });

      reveals.forEach(function(el) {
        observer.observe(el);
      });
    })();

    // Universal Reactive Card Effect (Pokemon-style)
    (function() {
      var cards = document.querySelectorAll('[data-reactive-card]');
      
      cards.forEach(function(card) {
        var spotlight = card.querySelector('.card-spotlight');
        var glint = card.querySelector('.card-glint');
        
        var bounds = null;
        var isHovering = false;
        
        function rotateCard(e) {
          if (!bounds) return;
          
          var mouseX = e.clientX;
          var mouseY = e.clientY;
          
          // Calculate position relative to card center
          var centerX = bounds.left + bounds.width / 2;
          var centerY = bounds.top + bounds.height / 2;
          
          // Calculate rotation (max 10 degrees)
          var rotateX = ((mouseY - centerY) / (bounds.height / 2)) * -10;
          var rotateY = ((mouseX - centerX) / (bounds.width / 2)) * 10;
          
          // Calculate spotlight position
          var spotlightX = ((mouseX - bounds.left) / bounds.width) * 100;
          var spotlightY = ((mouseY - bounds.top) / bounds.height) * 100;
          
          // Calculate glint angle based on mouse position
          var angle = Math.atan2(mouseY - centerY, mouseX - centerX) * (180 / Math.PI) + 90;
          
          // Apply transforms
          card.style.setProperty('--rotateX', rotateX + 'deg');
          card.style.setProperty('--rotateY', rotateY + 'deg');
          
          if (spotlight) {
            spotlight.style.setProperty('--mouse-x', spotlightX + '%');
            spotlight.style.setProperty('--mouse-y', spotlightY + '%');
          }
          
          if (glint) {
            glint.style.setProperty('--glint-angle', angle + 'deg');
            glint.style.setProperty('--glint-x', spotlightX + '%');
            glint.style.setProperty('--glint-y', spotlightY + '%');
          }
        }
        
        function resetCard() {
          card.style.setProperty('--rotateX', '0deg');
          card.style.setProperty('--rotateY', '0deg');
          bounds = null;
          isHovering = false;
        }
        
        card.addEventListener('mouseenter', function(e) {
          bounds = card.getBoundingClientRect();
          isHovering = true;
        });
        
        card.addEventListener('mousemove', function(e) {
          if (isHovering) {
            requestAnimationFrame(function() {
              rotateCard(e);
            });
          }
        });
        
        card.addEventListener('mouseleave', function() {
          resetCard();
        });
        
        // Touch support
        card.addEventListener('touchstart', function(e) {
          bounds = card.getBoundingClientRect();
          isHovering = true;
        });
        
        card.addEventListener('touchmove', function(e) {
          if (isHovering && e.touches.length > 0) {
            var touch = e.touches[0];
            rotateCard({
              clientX: touch.clientX,
              clientY: touch.clientY
            });
          }
        });
        
        card.addEventListener('touchend', function() {
          resetCard();
        });
      });
    })();

    // Hero Video Handling
    (function() {
      var video = document.querySelector('.hero-video');
      if (!video) return;

      video.playbackRate = 0.85;
      
      video.addEventListener('loadeddata', function() {
        video.playbackRate = 0.85;
      });

      if (video.paused) {
        video.play().catch(function() {});
      }
    })();

    // Smooth Scroll for Anchor Links
    (function() {
      document.querySelectorAll('a[href^="#"]').forEach(function(anchor) {
        anchor.addEventListener('click', function(e) {
          var href = this.getAttribute('href');
          if (href === '#') return;
          
          var target = document.querySelector(href);
          if (target) {
            e.preventDefault();
            var navHeight = document.querySelector('nav').offsetHeight;
            var targetPosition = target.getBoundingClientRect().top + window.pageYOffset - navHeight;
            
            window.scrollTo({
              top: targetPosition,
              behavior: 'smooth'
            });
          }
        });
      });
    })();
  </script>

</body>
